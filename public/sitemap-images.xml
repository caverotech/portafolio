<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap de imágenes de caverotech.com

  Le dice a Google Imágenes qué fotos hay y de qué son. Sin esto, las
  imágenes de una SPA rara vez se indexan: el rastreador no las
  encuentra porque se cargan con JavaScript.

  ══════════════════════════════════════════════════════════════
  CÓMO AÑADIR UNA FOTO NUEVA

  1. Pon el archivo en public/galeria/ con un nombre descriptivo
     en minúsculas y con guiones. El nombre del archivo es una
     señal de posicionamiento real:

       ✅ alexys-cavero-charla-ia-colegio-ica.jpg
       ❌ IMG_20231105_094512.jpg

  2. Copia un bloque <image:image> de los de abajo y cambia:
       image:loc     → la ruta del archivo
       image:title   → qué es, con las palabras que alguien buscaría
       image:caption → una frase describiendo la escena

  3. Actualiza <lastmod> arriba a la fecha de hoy.

  4. Sube los cambios y vuelve a enviar el sitemap en Google Search
     Console (Sitemaps → escribir sitemap-images.xml → Enviar).
  ══════════════════════════════════════════════════════════════
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

  <url>
    <loc>https://www.caverotech.com/</loc>

    <!-- ══ RETRATO ══ -->
    <image:image>
      <image:loc>https://www.caverotech.com/Foto-2026.jpeg</image:loc>
      <image:title>Alexys Cavero, Desarrollador Full Stack en IA y Automatización en Ica, Perú</image:title>
      <image:caption>Retrato profesional de Alexys Cavero, especialista en agentes de IA y automatización de procesos con n8n y Claude.</image:caption>
    </image:image>
  </url>

  <!-- Cada foto va bajo la página donde se muestra: Google cruza el
       sitemap con el HTML de esa URL. Las de Momentos están en
       /momentos (prerenderizado), no en la portada. -->
  <url>
    <loc>https://www.caverotech.com/momentos</loc>

    <!-- ══ MOMENTOS · ENSEÑANZA ══
         Solo las fotos publicadas (lista en .gitignore). Las portadas
         de cada momento, más una por escena clave. -->
    <image:image>
      <image:loc>https://www.caverotech.com/galeria/ensenanza/kidsapiens-taller-ia-ninos-mariategui-04.jpg</image:loc>
      <image:title>Kidsapiens · Taller de Inteligencia Artificial para niños en Ica</image:title>
      <image:caption>Taller Kidsapiens de inteligencia artificial para estudiantes de primaria en el colegio José Carlos Mariátegui, Ica.</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://www.caverotech.com/galeria/ensenanza/kidsapiens-taller-ia-ninos-mariategui-06.jpg</image:loc>
      <image:title>Obras creadas con IA por niños del taller Kidsapiens</image:title>
      <image:caption>Estudiantes del taller Kidsapiens muestran sus imágenes generadas con inteligencia artificial, impresas y enmarcadas.</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://www.caverotech.com/galeria/ensenanza/charla-ia-colegio-antonia-moreno-de-caceres-03.jpg</image:loc>
      <image:title>Charla de Inteligencia Artificial en el colegio Antonia Moreno de Cáceres, Ica</image:title>
      <image:caption>Charla de divulgación sobre inteligencia artificial para estudiantes del colegio Antonia Moreno de Cáceres.</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://www.caverotech.com/galeria/ensenanza/charla-ia-colegio-antonia-moreno-de-caceres-01.jpg</image:loc>
      <image:title>Auditorio lleno en la charla de IA del colegio Antonia Moreno de Cáceres</image:title>
      <image:caption>Estudiantes participando con las manos arriba durante la charla de inteligencia artificial.</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://www.caverotech.com/galeria/ensenanza/exposicion-ia-robotica-san-francisco-college-01.jpg</image:loc>
      <image:title>Exposición de IA y robótica básica en San Francisco College, Ica</image:title>
      <image:caption>Stand de inteligencia artificial y robótica básica para niños en San Francisco College.</image:caption>
    </image:image>

    <!-- ══ MOMENTOS · UTP TECH SUMMIT ══ -->
    <image:image>
      <image:loc>https://www.caverotech.com/galeria/formacion/utp-tech-summit-2025-ica.jpg</image:loc>
      <image:title>UTP Tech Summit 2025 · Conferencia de tecnología en la UTP Ica</image:title>
      <image:caption>Afiche del UTP Tech Summit en la Universidad Tecnológica del Perú, sede Ica, con ponentes de Oracle, Google y Tata Consultancy Services.</image:caption>
    </image:image>

    <!-- ══ MOMENTOS · VOLUNTARIADO ══
         Cuando llegue la foto de Huacachina, añadir aquí su bloque. -->
  </url>

  <!-- ══ PROYECTOS ══
         Las capturas de los proyectos son hoy imágenes de stock de
         Unsplash, alojadas fuera del dominio: no aportan nada indexado
         a tu nombre. Cuando sustituyas cada `imagen` de
         src/data/portafolio.js por una captura real en
         public/proyectos/, añade su bloque dentro de un <url> con la
         página donde se muestra (p. ej. /proyectos). Ejemplo listo:

    <image:image>
      <image:loc>https://www.caverotech.com/proyectos/vistony-ruta-nazca-app-ventas-gps.jpg</image:loc>
      <image:title>Vistony Ruta Nazca · App de ventas en campo con ruta GPS</image:title>
      <image:caption>Aplicación móvil de ventas en campo con 286 clientes geocodificados y ruta optimizada por GPS, desarrollada por Alexys Cavero.</image:caption>
    </image:image>
    -->
</urlset>
